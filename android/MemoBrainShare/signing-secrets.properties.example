# Copy this file to signing-secrets.properties and replace all values.
# Never commit signing-secrets.properties or the keystore itself.
# MEMOBRAIN_KEYSTORE_PATH may be an absolute path or a path relative to android/MemoBrainShare.
# On Windows, forward slashes avoid Java .properties escaping issues.
# Both Release and Develop APKs use this persistent key when configured.
# Do not change the keystore or alias after distributing either application.
MEMOBRAIN_KEYSTORE_PATH=C:/Users/yourname/Documents/AndroidKeys/MemoBrain-upload.jks
MEMOBRAIN_KEYSTORE_PASSWORD=replace-with-keystore-password
MEMOBRAIN_KEY_ALIAS=memobrain-upload
MEMOBRAIN_KEY_PASSWORD=replace-with-key-password

# Optional: preserve an existing Develop certificate by using its original key.
# When omitted, Develop uses the same persistent key configured above.
# MEMOBRAIN_DEVELOP_KEYSTORE_PATH=C:/Users/yourname/.android/debug.keystore
# MEMOBRAIN_DEVELOP_KEYSTORE_PASSWORD=android
# MEMOBRAIN_DEVELOP_KEY_ALIAS=androiddebugkey
# MEMOBRAIN_DEVELOP_KEY_PASSWORD=android
