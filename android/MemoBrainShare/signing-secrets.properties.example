# Copy this file to signing-secrets.properties and replace all values.
# Never commit signing-secrets.properties or the keystore itself.
# MEMOBRAIN_KEYSTORE_PATH may be an absolute path or a path relative to android/MemoBrainShare.
MEMOBRAIN_KEYSTORE_PATH=C:\\Users\\yourname\\Documents\\AndroidKeys\\MemoBrain-upload.jks
MEMOBRAIN_KEYSTORE_PASSWORD=replace-with-keystore-password
MEMOBRAIN_KEY_ALIAS=memobrain-upload
MEMOBRAIN_KEY_PASSWORD=replace-with-key-password
