<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MemoBrain" android:textStyle="bold" android:textSize="16sp"
        android:textColor="#FFFFFF" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_search" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="検索" android:textSize="12sp" />
        <Button android:id="@+id/widget_list" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="一覧" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_todo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="TODO" android:textSize="12sp" />
        <Button android:id="@+id/widget_read_later" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="あとで読む" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
