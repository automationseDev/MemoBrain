<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MemoBrain  •  DEV"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_history"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_icon_button"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="履歴"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="まだ送信履歴がありません"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_memo"
            style="@style/WidgetAction"
            android:background="@drawable/widget_primary_button"
            android:text="＋ メモ"
            android:textColor="@color/widget_on_accent" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/widget_file"
            style="@style/WidgetAction"
            android:background="@drawable/widget_secondary_button"
            android:text="▣ ファイル" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/widget_chat"
            style="@style/WidgetAction"
            android:background="@drawable/widget_secondary_button"
            android:text="✦ AIチャット" />
    </LinearLayout>
</LinearLayout>
